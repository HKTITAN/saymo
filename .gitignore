# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rendered posts
/export

# posts made in the tool, with their uploads and videos
/posts

# motion engines (studio/): renders, installs and build output
/studio/out/
/studio/**/node_modules/
/studio/fframes/**/target/
/studio/hyperframes/**/.hyperframes/
/studio/hyperframes/**/renders/

# films made in the studio, with their history and renders
/films
