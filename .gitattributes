# GitHub's Languages bar counts only Saymo's own code.

# Agent skills bundled for the studio's chat (mostly third party)
.claude/** linguist-vendored

# Browser libraries copied into the starters
**/vendor/** linguist-vendored

# Shell scripts keep Unix line endings, so bash runs them from a Windows
# checkout too.
*.sh text eol=lf

